# ====================================================================
# Shital Dental Services — Backend Environment Configuration Example
# ====================================================================

# Neon PostgreSQL Database Connection String (from Neon console: https://console.neon.tech)
# Use the connection pooling URL (contains -pooler) for serverless and cloud deployments.
DATABASE_URL=postgresql://[user]:[password]@[endpoint-id]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require

# Node Environment ('development' or 'production')
NODE_ENV=production

# Server Port (Render sets this dynamically via PORT environment variable)
PORT=5000

# CORS Allowed Frontend Origin (Your Vercel deployment URL)
# Example: https://shital-dental-services.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app

# JWT Authentication Secret (Use a strong random string >= 32 characters in production)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long_for_security
JWT_EXPIRES_IN=7d

# Initial Administrator Credentials (used only on first-time setup or npm run setup-admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here
