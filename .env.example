# ====================================================================
# Shital Dental Services — Environment Configuration Example
# ====================================================================

# Neon PostgreSQL Database Connection String
# Get this from your Neon Console (https://console.neon.tech)
# Format: postgresql://[user]:[password]@[endpoint-id].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# JWT Authentication Secret (Use a strong random string in production)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long_for_security
JWT_EXPIRES_IN=7d

# Initial Administrator Credentials (Change before production deployment)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisSecureAdminPassword2026!

# Application Environment & Networking
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
