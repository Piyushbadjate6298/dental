# ====================================================================
# Shital Dental Services — Frontend Environment Configuration Example
# ====================================================================

# Base URL of the backend API service (hosted on Render)
# In development, leave blank to use the local Vite proxy (/api)
# In production on Vercel, set this to your Render backend URL:
# Example: https://shital-dental-backend.onrender.com/api
VITE_API_URL=
