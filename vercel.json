{
  "buildCommand": "node scripts/build.js --frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://dental-1-9jz8.onrender.com/api"
    },
    {
      "source": "/api/:match*",
      "destination": "https://dental-1-9jz8.onrender.com/api/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
